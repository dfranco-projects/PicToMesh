# Optional: copy to .env to override defaults
# All variables use the PICTOMESH_ prefix
# Docker compose sets its own PICTOMESH_REDIS_URL / PICTOMESH_MEDIA_DIR for containers

PICTOMESH_REDIS_URL=redis://localhost:6379
PICTOMESH_MEDIA_DIR=media
PICTOMESH_CORS_ORIGINS=["http://localhost:3000"]
PICTOMESH_IMAGE_THRESHOLD=2
